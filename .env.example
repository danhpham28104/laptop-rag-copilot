# ============================================================
# .env.example - Mẫu cấu hình biến môi trường
# ============================================================
# Sao chép file này thành .env và điền thông tin thực tế:
#   cp .env.example .env
# ============================================================

# ============================================================
# DEMO / MOCK MODE
# Dùng để demo offline, không gọi Gemini/OpenAI thật
# ============================================================
MOCK_EMBEDDINGS=true

# ============================================================
# LLM PROVIDER SELECTION
# Chọn "gemini" hoặc "openai"
# ============================================================
LLM_PROVIDER=gemini


# ============================================================
# GOOGLE GEMINI API (dùng khi LLM_PROVIDER=gemini)
# Lấy API key tại: https://aistudio.google.com/app/apikey
# ============================================================
GOOGLE_API_KEY=your-google-gemini-api-key-here

# LLM Model (gemini-2.0-flash, gemini-1.5-pro, gemini-1.5-flash)
LLM_MODEL_NAME=gemini-2.0-flash

# Embedding Model (chỉ dùng cho Gemini)
EMBEDDING_MODEL_NAME=models/text-embedding-004


# ============================================================
# OPENAI API (dùng khi LLM_PROVIDER=openai)
# Lấy API key tại: https://platform.openai.com/api-keys
# ============================================================
# OPENAI_API_KEY=sk-your-openai-api-key-here
# LLM_MODEL_NAME=gpt-4o-mini
# EMBEDDING_MODEL_NAME=text-embedding-3-small


# ============================================================
# CHROMADB VECTOR DATABASE
# ============================================================
# Đường dẫn lưu trữ ChromaDB (tương đối từ thư mục dự án)
CHROMA_DB_PATH=./chroma_db

# Tên collection trong ChromaDB
CHROMA_COLLECTION_NAME=laptops


# ============================================================
# SERVER CONFIGURATION
# ============================================================
HOST=0.0.0.0
PORT=8000
DEBUG=false


# ============================================================
# RAG PIPELINE CONFIGURATION
# ============================================================
# Số lượng sản phẩm lấy ra từ vector search (trước re-ranking)
TOP_K_RESULTS=10

# Số lượng sản phẩm tối đa trả về trong kết quả cuối
MAX_RECOMMENDED_PRODUCTS=5

# Ngưỡng confidence score tối thiểu (0.0 - 1.0)
MIN_CONFIDENCE_THRESHOLD=0.3


# ============================================================
# CORS - Địa chỉ frontend/backend được phép gọi API
# Ngăn cách nhiều địa chỉ bằng dấu phẩy
# ============================================================
ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000
